{
  "name": "solarwhere",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SolarWhere — a comprehensive solar planning, estimation and optimization platform for homeowners, businesses and governments.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run test:unit && npm run test:engine && npm run test:render",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:engine": "tsx test/engine.smoke.ts",
    "test:render": "tsx --tsconfig ./tsconfig.test.json test/render.smoke.tsx",
    "e2e": "tsx test/e2e/run.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "playwright": "^1.61.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
